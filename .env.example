# auto picks mlx on Apple Silicon and torch everywhere else; fake renders tones (no model).
OMNIVOICE_BACKEND=auto
# Empty uses the backend's default: k2-fsa/OmniVoice (torch), mlx-community/OmniVoice-bf16 (mlx).
OMNIVOICE_MODEL=
OMNIVOICE_API_MODEL=omnivoice
OMNIVOICE_API_KEY=
# Your voices: <name>.wav + <name>.txt (transcript), or <name>.json for a designed voice.
OMNIVOICE_VOICES_DIR=voices
# Encoded voice prompts (a cache, safe to delete): .pt with torch, .safetensors with MLX.
OMNIVOICE_PROMPTS_DIR=prompts
OMNIVOICE_MAX_BATCH_ITEMS=16
OMNIVOICE_MAX_BATCH_CHARS=12000
OMNIVOICE_MAX_ITEM_CHARS=1500
OMNIVOICE_DEFAULT_NUM_STEPS=32
OMNIVOICE_PING_SECONDS=10

# torch backend only
OMNIVOICE_DEVICE=auto
OMNIVOICE_ENABLE_FLASHINFER=auto

# mlx backend only: transcribes reference recordings sent without a transcript (~1 GB, on first use)
OMNIVOICE_TRANSCRIBE_MODEL=mlx-community/Qwen3-ASR-0.6B-8bit
